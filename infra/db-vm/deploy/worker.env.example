# /opt/dompetku/env/worker.env (root, 600). Dibaca layanan compose `worker` (S7).
# Tanpa rahasia di repo; nilai diisi pemilik langsung di VM, tidak lewat chat
# (docs/ops/runbook-s7-worker.md). Selama berkas ini belum ada, deployer melewati worker
# (`worker_env_missing`) dan tetap memasang web.

# Postgres sebagai dompetku_worker (password = DOMPETKU_WORKER_PASSWORD di env/db-roles.env),
# TLS ke CA DompetKu yang dipasang compose di /etc/dompetku/ca.crt. Bentuk:
# postgres://dompetku_worker:<password>@postgres:5432/dompetku?sslmode=verify-full&sslrootcert=/etc/dompetku/ca.crt
DATABASE_URL=

# Nilai tanpa tanda kutip: deployer memvalidasi berkas ini dengan `docker run --env-file`
# (worker.mjs --check-config), yang tidak membuang kutip.

# URL ping Healthchecks.io (tanpa /start atau /fail; worker menambahkannya sendiri).
# Kosong = ping dilewati (log `alert_skipped`), jadi isi keduanya di produksi.
# Check dompetku-dq: job dq_reconcile (01:00 WIB).
HC_DQ_URL=
# Check dompetku-jobs: dipakai bersama 4 job purge (purge_idempotency, purge_unfinished_users,
# purge_audit, purge_voided).
HC_JOBS_URL=
