# /opt/dompetku/env/openwa.env (root, 600). Dibaca layanan compose `openwa` (Catat via WhatsApp).
# Tanpa rahasia di repo; nilai diisi pemilik langsung di VM, tidak lewat chat
# (docs/ops/runbook-wa.md). Selama berkas ini belum ada, deployer melewati openwa
# (`openwa_env_missing`) dan tetap memasang web; bila openwa masih berjalan, dihentikan.
#
# Dipatok di compose.yml (bagian `environment`, menang atas berkas ini; jangan diisi di sini):
#   ENGINE_TYPE=baileys            tanpa Chromium
#   DATABASE_TYPE=sqlite           SQLite di volume openwa_data: /app/data/openwa.sqlite (bawaan) dan
#                                  /app/data/main.sqlite (key/audit). DATABASE_NAME sengaja tidak
#                                  diisi: untuk SQLite nilainya menjadi path berkas, dan di rootfs
#                                  read-only path di luar /app/data membuat boot-loop.
#   RESOLVE_LID_TO_PHONE=true      pengirim @lid mendapat senderPhone; tanpa ini tidak bisa dihubungkan
#   AUTO_START_SESSIONS=true       sesi menyala lagi sesudah restart/recreate container
#   WEBHOOK_SSRF_PROTECT=true, SSRF_ALLOWED_HOSTS=wa-proxy    webhook ke http://wa-proxy:8081 diizinkan
#   WEBHOOK_TIMEOUT=20000          > 10 s batas sendText di handler web
#   MESSAGE_RETENTION_DAYS=7, UPDATE_CHECK_ENABLED=false, ENABLE_SWAGGER=false, PORT=2785
#   Sesi Baileys di /app/data/baileys (BAILEYS_AUTH_DIR bawaan), juga di volume openwa_data.
#
# Hubungan dengan env/web.env (nilai TIDAK disalin ke sini):
#   - OPENWA_API_KEY (web.env) = key operator yang dibuat dengan API_MASTER_KEY di bawah (runbook
#     langkah 5), dibatasi ke sesi bot dan alamat wa-proxy 172.16.26.2 (request web sampai ke
#     OpenWA lewat wa-proxy). Bukan API_MASTER_KEY. TRUSTED_PROXIES tidak diisi: OpenWA memakai
#     alamat socket, bukan X-Forwarded-For.
#   - WA_WEBHOOK_SECRET (web.env) = rahasia HMAC yang didaftarkan ke webhook OpenWA lewat API
#     (runbook langkah 6). OpenWA menyimpannya di SQLite; tidak dibaca dari env, jadi tidak di sini.
#   - OPENWA_URL (web.env) = http://wa-proxy:2786 (web tidak berbagi network dengan openwa).

# Kunci admin awal, dibaca hanya saat boot pertama (belum ada API key). Minimal 32 karakter acak,
# mis. `openssl rand -hex 32`; production menolak nilai lebih pendek atau bawaan. Mengubahnya
# sesudah boot pertama tidak berpengaruh: rotasi lewat POST /api/auth/api-keys + cabut key lama.
# Kosong = OpenWA membuat key acak di /app/data/.api-key (runbook tidak memakai jalur itu).
API_MASTER_KEY=

# Opsional, disarankan: pepper HMAC untuk hash API key. Isi SEBELUM boot pertama atau jangan sama
# sekali: mengisi/mengubahnya sesudah ada key mengunci semua key, termasuk admin. Bila diisi,
# simpan juga di password manager pemilik (restore volume tanpa pepper yang sama = key tidak valid).
# API_KEY_PEPPER=

# Log JSON (bawaan production). Jangan pernah DATABASE_LOGGING=true: query beserta isi pesan.
LOG_LEVEL=info
