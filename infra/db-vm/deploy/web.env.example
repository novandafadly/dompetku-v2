# /opt/dompetku/env/web.env (root, 600). Tanpa rahasia di repo; nilai diisi di VM.
# Minggu pertama M0b: CSP penuh report-only (TRD §3.4). Hapus baris ini untuk menegakkan.
CSP_REPORT_ONLY=1
# Jangan pernah mengisi NEXT_PUBLIC_PROTOTYPE di produksi.

# S4 auth (docs/ops/auth.md). Nilai diisi pemilik langsung di VM, tidak lewat chat.
# Postgres sebagai dompetku_web (password dari env/db-roles.env), TLS ke CA DompetKu.
DATABASE_URL=postgres://dompetku_web:<password>@postgres:5432/dompetku?sslmode=verify-full&sslrootcert=/etc/dompetku/ca.crt
# Minimal 32 karakter acak (mis. `openssl rand -base64 48`). Juga mengenkripsi rahasia TOTP:
# hanya dirotasi saat insiden (TRD §3.4), kalau tidak 2FA semua akun mati.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://dompet.novandafadly.com
# Opsional; bawaan = hostname BETTER_AUTH_URL. Mengubahnya membuat passkey lama tidak berlaku.
AUTH_RP_ID=dompet.novandafadly.com
RESEND_API_KEY=
AUTH_EMAIL_FROM=DompetKu <dompet@novandafadly.com>

# Catat via WhatsApp (OpenWA, docs/ops/runbook-wa.md); WA_WEBHOOK_SECRET, OPENWA_URL,
# OPENWA_API_KEY, OPENWA_SESSION kosong = fitur mati (batas dan WA_BOT_NUMBER saja tidak menyalakan).
# OPENWA_SESSION = ID sesi (UUID), bukan namanya. OPENWA_API_KEY = key operator khusus web
# (owa_k1_..., dibatasi ke sesi itu dan alamat wa-proxy 172.16.26.2), bukan API_MASTER_KEY di
# openwa.env.
# WA_WEBHOOK_SECRET (min. 16 karakter) = rahasia yang didaftarkan ke webhook OpenWA; satu-satunya
# salinan di VM ada di berkas ini (pendaftaran webhook membacanya dari sini).
WA_WEBHOOK_SECRET=
# Sengaja kosong di contoh: salinan yang belum diisi tidak boleh setengah terkonfigurasi. Isi saat
# memasang (runbook-wa.md); nilainya http://wa-proxy:2786 (web bicara ke OpenWA hanya lewat
# sidecar wa-proxy di network compose `wa_web`, yang hanya meneruskan POST send-text), bukan
# 127.0.0.1 (itu container web sendiri) dan bukan http://openwa:2785 (tidak terjangkau dari web).
OPENWA_URL=
OPENWA_API_KEY=
OPENWA_SESSION=
# Batas sengaja rendah: membatasi banjir webhook palsu dari openwa yang disusupi (paling banyak
# 10 entri/menit per nomor, masing-masing paling besar Rp25.000.000). Naikkan hanya bila memang
# mencatat nominal lebih besar lewat WhatsApp; nominal lebih besar dicatat lewat app. Kosong =
# bawaan kode 100000000 dan 30 (docs/ops/runbook-wa.md "Risiko").
WA_MAX_AMOUNT=25000000
WA_RATE_PER_MIN=10
WA_BOT_NUMBER=
