# /opt/dompetku/env/deploy.env (root, 600). Dibaca /opt/dompetku/bin/deploy.
# Token GHCR read-only (read:packages). Diisi pemilik langsung di VM.
GHCR_USER=
GHCR_TOKEN=
# cosign-key = tanda tangan + attestation SBOM cosign dengan kunci pemilik, tanpa log transparansi
# (butuh cosign v3 di VM). Hanya kunci PUBLIK di VM; kunci pribadi tidak pernah di VM.
VERIFY=cosign-key
COSIGN_PUBLIC_KEY=/opt/dompetku/keys/cosign.pub
# Opsional: URL ping Healthchecks.io khusus deploy (gagal -> /fail).
HC_PING_URL=
