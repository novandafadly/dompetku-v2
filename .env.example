# Tidak ada nilai di sini. Salin ke apps/web/.env.local dan isi sendiri; jangan commit nilai asli.
# Penjelasan tiap variabel: docs/ops/auth.md. Produksi: infra/db-vm/deploy/web.env.example.

# Mode prototipe (data demo, auth tiruan). Isi 1 hanya untuk pratinjau Vercel dan e2e prototipe.
NEXT_PUBLIC_PROTOTYPE=

# Auth (S4)
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
AUTH_RP_ID=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# 0 = tanpa cek kata sandi bocor (HIBP), hanya untuk lokal/tes tanpa internet.
AUTH_CHECK_PWNED=
# Lokal tanpa Resend: 1 = email ditulis ke log server; AUTH_EMAIL_FILE = ke berkas (tes e2e auth).
AUTH_EMAIL_LOG=
AUTH_EMAIL_FILE=

# Minggu report-only CSP (TRD §3.4).
CSP_REPORT_ONLY=

# Tes integrasi dan e2e auth (cluster sekali pakai, packages/db/README.md).
TEST_DATABASE_URL=
TEST_DATABASE_ADMIN_URL=
AUTH_E2E_DATABASE_URL=
AUTH_E2E_ADMIN_URL=
