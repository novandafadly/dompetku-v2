# /opt/dompetku/env/backup.env (root:root 600). Dipakai WAL-G dan uji restore (S2).
# Nilai non-rahasia sudah diisi; tiga baris rahasia di bawah diisi pemilik langsung di VM.

# Bucket OCI Object Storage (S3-compatible), region ap-batam-1.
WALG_S3_PREFIX=s3://dompetku-backup/pg17
AWS_ENDPOINT=https://ax40rkaxashz.compat.objectstorage.ap-batam-1.oraclecloud.com
AWS_REGION=ap-batam-1
AWS_S3_FORCE_PATH_STYLE=true

# Customer Secret Key user OCI dompetku-backup (walg-dompetku).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Kunci enkripsi sisi klien: 64 karakter hex (32 byte). Salinan wajib di password manager pemilik.
WALG_LIBSODIUM_KEY=
WALG_LIBSODIUM_KEY_TRANSFORM=hex
