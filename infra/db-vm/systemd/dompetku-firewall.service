[Unit]
Description=DompetKu: port gw hanya dari VM App, egress openwa hanya ke internet (iptables)
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/dompetku/bin/firewall.sh up
ExecStop=/opt/dompetku/bin/firewall.sh down

[Install]
WantedBy=docker.service
